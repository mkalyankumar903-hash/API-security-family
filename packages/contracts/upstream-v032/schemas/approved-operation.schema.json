{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.lumicsec.local/api-family/phase0-v032/approved-operation.schema.json",
  "title": "approved-operation PROPOSED NOT FROZEN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method",
    "origin",
    "path_template",
    "body_schema_digest",
    "side_effect_class",
    "fixture_reference",
    "credential_profile_reference",
    "cleanup_procedure_digest"
  ],
  "properties": {
    "method": {
      "enum": [
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "origin": {
      "type": "string",
      "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?::(?:8443|9443))?$"
    },
    "path_template": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9_{}./-]+$",
      "maxLength": 1024
    },
    "body_schema_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "side_effect_class": {
      "enum": [
        "FIXTURE_ONLY",
        "REVERSIBLE_TEST_ONLY"
      ]
    },
    "fixture_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "credential_profile_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "cleanup_procedure_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
