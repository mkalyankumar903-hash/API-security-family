{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.lumicsec.local/api-family/phase0-v032/permit-decision.schema.json",
  "title": "permit-decision PROPOSAL NOT FROZEN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed",
    "reason_code",
    "permit_id",
    "request_fingerprint",
    "approved_plan_digest",
    "lease_generation",
    "policy_revision",
    "authority_revision",
    "approved_max_request_bytes",
    "approved_max_response_bytes",
    "expires_at",
    "policy_generation",
    "permit_binding_digest",
    "single_use_egress_token",
    "binding_fields"
  ],
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "ALLOWED",
        "AUTH_REQUIRED",
        "TENANT_ACCESS_DENIED",
        "MEMBERSHIP_REVOKED",
        "ENTITLEMENT_DENIED",
        "TARGET_NOT_VERIFIED",
        "AUTHORIZATION_REQUIRED",
        "AUTHORIZATION_EXPIRED",
        "EXECUTION_SCOPE_DENIED",
        "POLICY_BLOCKED",
        "RATE_LIMITED",
        "JOB_CANCELLED",
        "LEASE_EXPIRED",
        "RUNTIME_UNAVAILABLE",
        "VERSION_INCOMPATIBLE"
      ]
    },
    "permit_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "approved_plan_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 0
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authority_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "approved_max_request_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "approved_max_response_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_generation": {
      "type": "integer",
      "minimum": 0
    },
    "permit_binding_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "single_use_egress_token": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8192
    },
    "binding_fields": {
      "anyOf": [
        {
          "$ref": "./permit-binding-fields.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "ALLOWED"
          },
          "permit_id": {
            "type": "string",
            "format": "uuid"
          },
          "request_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "approved_plan_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "permit_binding_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "approved_max_response_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "approved_max_request_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "lease_generation": {
            "minimum": 1
          },
          "single_use_egress_token": {
            "type": "string",
            "minLength": 32
          },
          "binding_fields": {
            "$ref": "./permit-binding-fields.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "permit_id": {
            "type": "null"
          },
          "request_fingerprint": {
            "type": "null"
          },
          "approved_plan_digest": {
            "type": "null"
          },
          "permit_binding_digest": {
            "type": "null"
          },
          "single_use_egress_token": {
            "type": "null"
          },
          "binding_fields": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed": {
            "const": false
          }
        },
        "required": [
          "allowed"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "not": {
              "const": "ALLOWED"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed": {
            "const": true
          }
        },
        "required": [
          "allowed"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "ALLOWED"
          }
        }
      }
    }
  ]
}
