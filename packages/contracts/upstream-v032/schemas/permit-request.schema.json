{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.lumicsec.local/api-family/phase0-v032/permit-request.schema.json",
  "title": "permit-request PROPOSAL NOT FROZEN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "organization_id",
    "agency_client_id",
    "actor_user_id",
    "job_id",
    "target_id",
    "authorization_id",
    "plan_digest",
    "operation_type",
    "execution_mode",
    "scope_id",
    "scope_hash",
    "spec_fingerprint",
    "policy_revision",
    "trusted_lease",
    "request_ordinal",
    "method",
    "canonical_request_url",
    "canonical_request_fingerprint",
    "normalized_path",
    "credential_profile_reference",
    "test_category",
    "request_body_digest",
    "planned_request_bytes",
    "max_response_bytes",
    "request_deadline_at",
    "idempotency_key",
    "mutation_approval_reference",
    "delegated_invocation",
    "expected_policy_generation",
    "planned_aggregate_request_bytes",
    "planned_aggregate_response_bytes"
  ],
  "properties": {
    "contract_version": {
      "const": "0.3.1-candidate"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "agency_client_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "actor_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "API_SECURITY_ASSESSMENT",
        "API_PENETRATION_TEST",
        "AUTONOMOUS_API_VAPT"
      ]
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "SPEC_ONLY",
        "READ_ONLY_PROBE",
        "CONTROLLED_ACTIVE",
        "MUTATING_STAGING",
        "HUMAN_REVIEW_PT"
      ]
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scope_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "spec_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trusted_lease": {
      "$ref": "./trusted-lease-proof.schema.json"
    },
    "request_ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "HEAD",
        "OPTIONS",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "canonical_request_url": {
      "type": "string",
      "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?::(?:8443|9443))?/[A-Za-z0-9._~!$&\\'()*+,;=:@%/?-]*$",
      "maxLength": 2048
    },
    "canonical_request_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "normalized_path": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 1024
    },
    "credential_profile_reference": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "test_category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "request_body_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "planned_request_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "request_deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "mutation_approval_reference": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "delegated_invocation": {
      "$ref": "./host-delegated-invocation.schema.json"
    },
    "expected_policy_generation": {
      "type": "integer",
      "minimum": 1
    },
    "planned_aggregate_request_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    },
    "planned_aggregate_response_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "execution_mode": {
            "enum": [
              "SPEC_ONLY",
              "HUMAN_REVIEW_PT"
            ]
          }
        },
        "required": [
          "execution_mode"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "request_body_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "MUTATING_STAGING"
          }
        }
      },
      "then": {
        "properties": {
          "mutation_approval_reference": {
            "type": "string",
            "minLength": 1
          },
          "request_body_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "READ_ONLY_PROBE"
          }
        }
      },
      "then": {
        "properties": {
          "method": {
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS"
            ]
          },
          "mutation_approval_reference": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "CONTROLLED_ACTIVE"
          }
        },
        "required": [
          "execution_mode"
        ]
      },
      "then": {
        "properties": {
          "method": {
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS"
            ]
          },
          "mutation_approval_reference": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "execution_mode": {
            "const": "MUTATING_STAGING"
          },
          "mutation_approval_reference": {
            "type": "string",
            "minLength": 1
          },
          "request_body_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
