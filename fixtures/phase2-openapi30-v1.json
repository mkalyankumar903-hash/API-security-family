{
  "openapi": "3.0.3",
  "info": {
    "title": "Billing Demo",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.fixture.invalid/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Bill": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/bills": {
      "get": {
        "operationId": "listBills",
        "tags": [
          "billing"
        ],
        "summary": "List bills",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Bill"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "status",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    }
  }
}
