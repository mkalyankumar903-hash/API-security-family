# PRIVATE unpushed CI-only build definition. Neither image has production Host authority.
FROM node:22-bookworm-slim AS builder
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.phase15.runtime.json ./
COPY packages ./packages
RUN ./node_modules/.bin/tsc --project tsconfig.phase15.runtime.json

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force \
    && mkdir -p /tmp/api-family \
    && chown -R node:node /tmp/api-family
COPY --from=builder --chown=node:node /src/build/phase15-runtime/packages ./packages
COPY --from=builder --chown=node:node /src/packages/database/migrations ./packages/database/migrations
COPY --from=builder --chown=node:node /src/packages/discovery/src/worker-entry-phase15.mjs ./packages/discovery/src/worker-entry.mjs
COPY --from=builder --chown=node:node /src/packages/contracts/upstream-v032/schemas ./packages/contracts/upstream-v032/schemas
USER node

FROM runtime AS api-service
CMD ["node","packages/service/src/server.js"]

FROM runtime AS private-worker
CMD ["node","packages/worker/src/main.js"]
