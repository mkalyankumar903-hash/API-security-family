{
  "name": "lumicsec-api-family",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:pg": "node --import tsx --test tests/*.pg.test.ts",
    "api": "node --env-file-if-exists=.env --import tsx packages/service/src/server.ts",
    "worker": "node --env-file-if-exists=.env --import tsx packages/worker/src/main.ts",
    "dev": "vite --host 127.0.0.1",
    "migrate": "node --env-file-if-exists=.env --import tsx packages/database/src/migrate.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "ajv": "8.17.1",
    "fastify": "5.5.0",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
