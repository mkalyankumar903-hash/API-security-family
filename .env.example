# Local synthetic testing only. Production startup intentionally fails closed.
NODE_ENV=development
SYNTHETIC_AUTH_ENABLED=true
DATABASE_URL=postgres://api_family:api_family_dev@127.0.0.1:55432/api_family
WORKER_DATABASE_URL=postgres://api_family_queue:api_family_worker_dev@127.0.0.1:55432/api_family
MIGRATION_DATABASE_URL=postgres://postgres:local_admin_only@127.0.0.1:55432/api_family
DEV_TOKENS_JSON={"local-test-token-alpha":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","local-test-token-beta":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"}
PORT=3001
VITE_API_BASE=http://127.0.0.1:3001
